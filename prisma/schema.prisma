generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FREELANCER
}

enum FreelancerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  phone            String?
  passwordHash     String
  role             UserRole          @default(FREELANCER)
  freelancerStatus FreelancerStatus? // null for ADMIN users
  applicationNote  String?
  appliedAt        DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  suspendedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  reviewedBy        User?               @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewsGiven      User[]              @relation("Reviewer")
  assignedContacts  Contact[]           @relation("AssignedTo")
  createdContacts   Contact[]           @relation("CreatedContacts")
  calls             Call[]
  activities        Activity[]
  notifications     Notification[]      @relation("ReceivedNotifications")
  sentNotifications Notification[]      @relation("SentNotifications")
  assignmentsFrom   AssignmentHistory[] @relation("AssignmentFrom")
  assignmentsTo     AssignmentHistory[] @relation("AssignmentTo")
  assignmentsBy     AssignmentHistory[] @relation("AssignmentBy")
  callAttempts      CallAttempt[]
  interactions      Interaction[]
  activityLogs      ActivityLog[]
}

model Contact {
  id           String    @id @default(cuid())
  name         String
  phone        String
  phone2       String?
  email        String?
  company      String?
  source       String?   // actual source e.g. "MOI + official website"
  callPriority String?   // from CSV call_priority: "A" | "B"
  status       String    @default("new") // new|queued|contacted|follow_up|converted|lost
  assignedToId String?
  topic        String?
  createdById  String
  deletedAt    DateTime? // soft delete timestamp
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo   User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy    User                @relation("CreatedContacts", fields: [createdById], references: [id])
  calls        Call[]
  activities   Activity[]
  tags         ContactTag[]
  assignments  AssignmentHistory[]
  callAttempts CallAttempt[]
  interactions Interaction[]

  @@index([deletedAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model AssignmentHistory {
  id          String   @id @default(cuid())
  contactId   String
  fromUserId  String?
  toUserId    String?
  changedById String
  reason      String?
  createdAt   DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id])
  fromUser  User?   @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUser    User?   @relation("AssignmentTo", fields: [toUserId], references: [id])
  changedBy User    @relation("AssignmentBy", fields: [changedById], references: [id])
}

model CallAttempt {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id])
  freelancerId String
  freelancer   User     @relation(fields: [freelancerId], references: [id])
  triggeredAt  DateTime @default(now())
  method       String   // "tel_link_click"
  userAgent    String?
  ipHash       String?  // hashed IP for privacy-safe abuse detection

  interactions Interaction[]

  @@index([contactId])
  @@index([freelancerId])
  @@index([triggeredAt])
}

model Interaction {
  id                   String          @id @default(cuid())
  contactId            String
  contact              Contact         @relation(fields: [contactId], references: [id])
  freelancerId         String
  freelancer           User            @relation(fields: [freelancerId], references: [id])
  type                 InteractionType
  connected            Boolean?        // for CALL: did the prospect answer?
  callAttemptId        String?
  callAttempt          CallAttempt?    @relation(fields: [callAttemptId], references: [id])
  response             String?         // from Response lookup list
  interestArea         String?         // from Interest Area lookup list
  nextActivityRequired Boolean         @default(false)
  nextActivityDate     DateTime?
  nextActivity         String?
  notes                String?
  occurredAt           DateTime        @default(now())
  createdAt            DateTime        @default(now())

  @@index([contactId])
  @@index([freelancerId])
  @@index([type])
  @@index([occurredAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "CONTACT_EDITED", "CONTACT_DELETED", "CONTACT_RESTORED", "FREELANCER_APPROVED", "BULK_ASSIGN"
  targetType String   // "Contact" | "User" | "Tag" | etc.
  targetId   String?
  metadata   String?  // JSON string of before/after or relevant details
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Call {
  id                String   @id @default(cuid())
  contactId         String
  agentId           String
  callTime          DateTime @default(now())
  outcome           String
  responseLookup    String?
  recommendedAction String?
  interestLevel     String?
  feedbackNotes     String?
  createdAt         DateTime @default(now())

  contact    Contact    @relation(fields: [contactId], references: [id])
  agent      User       @relation(fields: [agentId], references: [id])
  activities Activity[]
}

model Activity {
  id           String    @id @default(cuid())
  contactId    String
  agentId      String
  callId       String?
  activityType String
  dueDate      DateTime
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  contact Contact  @relation(fields: [contactId], references: [id])
  agent   User     @relation(fields: [agentId], references: [id])
  call    Call?    @relation(fields: [callId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  relatedId String?
  isRead    Boolean  @default(false)
  sentById  String?
  createdAt DateTime @default(now())

  user   User  @relation("ReceivedNotifications", fields: [userId], references: [id])
  sentBy User? @relation("SentNotifications", fields: [sentById], references: [id])
}
